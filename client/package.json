{
  "name": "linhe-town-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "临河镇前端：Phaser 只画 canvas 内的世界，React 只画 canvas 外的 UI（DESIGN.md §4 硬约束）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "codegen:protocol": "openapi-typescript ../openapi.json -o ../shared/protocol.ts"
  },
  "dependencies": {
    "phaser": "^3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
