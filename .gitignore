# Dot-folders: per user rule all dot-prefixed folders stay out of git EXCEPT .orca.
# If the repo was seeded before this rule, untrack with: git rm -r --cached <dir>
.agents/
.claude/
.codex/
.kiro/
.opencode/

# CodeGraph index (local per-machine database)
.codegraph/

# .orca is the exception (user rule #4): the workflow contract files ARE tracked.
#   tracked:   .orca/workflow.txt, .orca/agent-registry.md
#   ignored:   .orca/talking.txt (per-worktree local inbox -> avoids cross-branch conflicts)
.orca/talking.txt
