# Dependencies
__pycache__/
*.py[cod]
node_modules/
.venv/
venv/

# Build artifacts
dist/
build/
*.egg-info/
# tsc -b 增量编译产物（kilo K03 请求：不入库；`tsc --noEmit` 不产生，`-b` 才产生）
*.tsbuildinfo

# Environment & secrets
.env
.env.*
# 例外：示例文件只含键名不含值，必须入库（否则安全清单 G4 不可执行）
!.env.example
*.local.json
credentials.json

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
__coverage__/
coverage/

# Performance benchmark artifacts (pi 裁决：基线与 runner 信息入 docs/perf/ 入库；每日 JSON 不入库)
perf/*.json
.benchmarks/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Game runtime data
saves/
logs/
*.log
*.db
*.sqlite

# Dot-folders: per user rule all dot-prefixed folders stay out of git EXCEPT .orca.
# If the repo was seeded before this rule, untrack with: git rm -r --cached <dir>
.agents/
.claude/
.codex/
.kiro/
.opencode/

# CodeGraph index (local per-machine database)
.codegraph/

# .orca is the exception (user rule #4): the workflow contract files ARE tracked.
#   tracked:   .orca/workflow.txt, .orca/agent-registry.md
#   ignored:   .orca/talking.txt (per-worktree local inbox -> avoids cross-branch conflicts)
.orca/talking.txt
