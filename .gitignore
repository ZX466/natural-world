# Dependencies
__pycache__/
*.py[cod]
node_modules/
.venv/
venv/

# Build artifacts
dist/
build/
*.egg-info/
# tsc -b 增量编译产物（kilo K03 请求：不入库；`tsc --noEmit` 不产生，`-b` 才产生）
*.tsbuildinfo

# Environment & secrets
.env
.env.*
# 例外：示例文件只含键名不含值，必须入库（否则安全清单 G4 不可执行）
!.env.example
*.local.json
credentials.json

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
__coverage__/
coverage/

# Performance benchmark artifacts (pi 裁决：基线与 runner 信息入 docs/perf/ 入库；每日 JSON/JSONL 不入库)
perf/*.json
perf/*.jsonl
# T4 探针运行产物（codex M4-S7：真模型响应正文不入库——同 perf 裁决；
# 报告随 nightly artifact 归档，仓内只留 docs/security/t4-corpus.md 语料真相源）
t4-results/
.benchmarks/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Game runtime data
saves/
logs/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite

# Dot-folders: per user rule #4 ALL dot-prefixed folders stay out of git EXCEPT .orca.
# If the repo was seeded before this rule, untrack with: git rm -r --cached <dir>
# （用户规则 #4，2026-09-20：agent 配置目录不入 git 也不推送；但本地须存在——
#   所有工作树都要有 .codegraph 与 .agents，.claude/.opencode/.codex 只在其对应工作树，主工作树全有）
.agent/
.agents/
.claude/
.codex/
.kiro/
.opencode/

# CodeGraph index (local per-machine database)
.codegraph/

# Catch-all: any other dot-prefixed folder is agent-local config/state -> never track.
.*/

# .orca is the exception (user rule #4/#7): the workflow contract files ARE tracked.
#   tracked:   .orca/workflow.txt, .orca/agent-registry.md, .orca/memory.md (rule #7: per-agent memory)
#   ignored:   .orca/talking.txt (per-worktree local inbox -> avoids cross-branch conflicts)
.orca/talking.txt

# .github: workflows 等必须入库（.*/ 兜底会挡新增文件，故显式例外；2026-09-21 裁决）
!.github/
!.github/**

# M7: 素材包原件（CC0 可重建，保持仓库精瘦）与人工下载暂存
_incoming/
sim/content/assets/zelda-like/pkg/
_rev_game_frames_0-11.png

# D8 调色板分析临时图（根目录 *.png 已清理，防再生成）
/tile_*.png
/palette_fix_*.png

# D13: LLM 主密钥引导文件（本机私有，绝不入库）
.linhe/
