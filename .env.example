# 环境变量示例 — 只含键名与说明，绝不填值（安全清单 G4）。
# 复制为 .env 后本地填写；.env 已被 .gitignore 排除，永不入库。
#
# 使用：cp .env.example .env   （PowerShell: Copy-Item .env.example .env）

# Fernet 主密钥（api_key 加密落库用）— 安全清单 K2
# 32 字节 url-safe base64（44 字符，形如 xxx...=）
# 生成方式（一次性、离线执行，勿写入任何仓库文件）：
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 缺失时后端必须拒绝启动（禁止静默 generate_key() 落盘）
LZ_MASTER_KEY=

# 数据库位置（可选，默认本地 SQLite 文件）
# LZ_DB_PATH=

# 日志级别（可选：DEBUG / INFO / WARNING；DEBUG 只用于本地排障，禁提交日志）
# LZ_LOG_LEVEL=